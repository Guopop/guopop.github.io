      </head>
      <body>
        <header class="site-header">
          <div class="site-header-inner">
            <a class="site-brand link-plain" href="/">
              <xsl:value-of select="$feed-title" />
            </a>
            <a class="back-link link-plain" href="/">
              ← 访问博客首页
            </a>
          </div>
        </header>

        <main class="container">
          <section class="info-card">
            <h1>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </svg>
              <span>
                <xsl:choose>
                  <xsl:when test="$is-atom">Web Feed（Atom订阅源）</xsl:when>
                  <xsl:otherwise>Web Feed（RSS订阅源）</xsl:otherwise>
                </xsl:choose>
              </span>
            </h1>
            <p>
              <xsl:choose>
                <xsl:when test="$is-atom">这是一个<strong>Atom</strong>格式的网站订阅源。如果您使用的是支持RSS/Atom的浏览器或扩展，可以直接在此查看文章预览。</xsl:when>
                <xsl:otherwise>这是一个<strong>RSS 2.0</strong>格式的网站订阅源。如果您使用的是支持RSS/Atom的浏览器或扩展，可以直接在此查看文章预览。</xsl:otherwise>
              </xsl:choose>
            </p>
            <p>
              要订阅<strong><xsl:value-of select="atom:feed/atom:title | rss/channel/title" /></strong>的最新内容，请将下方地址复制并添加到您的RSS阅读器（<a href="https://netnewswire.com/" target="_blank" rel="noopener noreferrer">NetNewsWire</a>、<a href="https://reeder.app/" target="_blank" rel="noopener noreferrer">Reeder</a>、<a href="https://feedly.com/" target="_blank" rel="noopener noreferrer">Feedly</a>、<a href="https://inoreader.com/" target="_blank" rel="noopener noreferrer">Inoreader</a>）中：
            </p>
            <button type="button" class="feed-url-box" id="feedUrlCopy" title="复制订阅地址">
              <span class="feed-url-label">Feed URL</span>
              <span class="feed-url-value" id="feedUrlValue">
                <xsl:choose>
                  <xsl:when test="atom:feed/atom:link[@rel='self']/@href">
                    <xsl:value-of select="atom:feed/atom:link[@rel='self']/@href" />
                  </xsl:when>
                  <xsl:when test="rss/channel/atom:link[@rel='self']/@href">
                    <xsl:value-of select="rss/channel/atom:link[@rel='self']/@href" />
                  </xsl:when>
                  <xsl:when test="rss/channel/link">
                    <xsl:value-of select="rss/channel/link" />
                  </xsl:when>
                  <xsl:otherwise>
                    <xsl:value-of select="atom:feed/atom:id" />
                  </xsl:otherwise>
                </xsl:choose>
              </span>
              <span class="feed-url-hint" id="feedUrlHint" role="status" aria-live="polite">复制订阅地址</span>
            </button>
          </section>

          <h2 class="feed-section-heading">最新文章列表</h2>

          <div class="feed-entries">
            <xsl:apply-templates select="atom:feed/atom:entry | rss/channel/item" />
          </div>

          <footer class="page-footer">
            <p>
              © <xsl:choose>
                <xsl:when test="$is-atom and string-length(atom:feed/atom:updated) &gt;= 4">
                  <xsl:value-of select="substring(atom:feed/atom:updated, 1, 4)" />
                </xsl:when>
                <xsl:when test="string-length(rss/channel/lastBuildDate) &gt;= 16">
                  <xsl:value-of select="substring(rss/channel/lastBuildDate, 13, 4)" />
                </xsl:when>
                <xsl:otherwise>2026</xsl:otherwise>
              </xsl:choose><xsl:text> </xsl:text><xsl:value-of select="$feed-title" />.
            </p>
          </footer>
        </main><script><![CDATA[(function(){function n(e){return(e<10?"0":"")+e}for(var e,t,o,i=document.querySelectorAll("time[data-utc]"),s=0;s<i.length;s++){if(t=i[s],o=Date.parse(t.getAttribute("data-utc")),isNaN(o))continue;e=new Date(o),t.title=t.textContent.trim(),t.textContent=e.getFullYear()+"-"+n(e.getMonth()+1)+"-"+n(e.getDate())+" "+n(e.getHours())+":"+n(e.getMinutes())}})(),function(){for(var e,n=document.querySelectorAll("[data-feed-html]"),t=0;t<n.length;t++)e=n[t],e.childElementCount===0&&e.textContent.trim()!==""&&(e.innerHTML=e.textContent)}(),function(){var e,t,s,o,i,r,c,n=[];function l(e){a(e.currentTarget)}function a(e){e.scrollWidth>e.clientWidth?e.tabIndex=0:document.activeElement===e?e.addEventListener("blur",l,{once:!0}):e.removeAttribute("tabindex")}for(c=new ResizeObserver(function(e){for(var t=0;t<e.length;t++)a(e[t].target)}),r=document.querySelectorAll(".feed-entry-content .highlight"),s=0;s<r.length;s++){for(o=r[s],e=o.querySelector(".lntable .lntd:last-child pre")||o.querySelector("pre"),i=o.querySelectorAll("pre[tabindex]"),t=0;t<i.length;t++)i[t]!==e&&i[t].removeAttribute("tabindex");e&&(n.push(e),c.observe(e))}n.length>0&&document.fonts.ready.then(function(){for(var e=0;e<n.length;e++)a(n[e])})}(),function(){var o,i,a,r,e=document.getElementById("feedUrlCopy"),s=document.getElementById("feedUrlValue"),t=document.getElementById("feedUrlHint");if(!e||!s||!t)return;o="复制订阅地址",i="已复制",a="无法自动复制，请手动选择上面的地址并复制。";function n(n){t.textContent=n?i:a,e.classList.toggle("copied",n),e.classList.toggle("failed",!n),clearTimeout(r),r=setTimeout(function(){t.textContent=o,e.classList.remove("copied"),e.classList.remove("failed")},2e3)}e.addEventListener("click",function(){try{navigator.clipboard.writeText(s.textContent.trim()).then(function(){n(!0)}).catch(function(){n(!1)})}catch{n(!1)}})}()]]></script>
      </body>
    </html>
  </xsl:template>

  <xsl:template match="atom:entry | item">
    <article>
      <h3 class="feed-entry-title">
        <a class="link-plain">
          <xsl:attribute name="href">
            <xsl:value-of select="atom:link[not(@rel) or @rel='alternate']/@href | link" />
          </xsl:attribute>
          <xsl:value-of select="atom:title | title" />
        </a>
      </h3>

      <div class="feed-entry-meta">
        <xsl:variable name="entry-time">
          <xsl:choose>
            <xsl:when test="atom:published"><xsl:value-of select="atom:published" /></xsl:when>
            <xsl:when test="atom:updated"><xsl:value-of select="atom:updated" /></xsl:when>
            <xsl:otherwise><xsl:value-of select="pubDate" /></xsl:otherwise>
          </xsl:choose>
        </xsl:variable>
        <xsl:if test="string($entry-time) != ''">
          <time data-utc="{$entry-time}">
            <xsl:if test="not(pubDate)">
              <xsl:attribute name="datetime"><xsl:value-of select="$entry-time" /></xsl:attribute>
            </xsl:if>
            <xsl:choose>
              <xsl:when test="pubDate">
                <xsl:value-of select="substring($entry-time, 1, 22)" />
              </xsl:when>
              <xsl:otherwise>
                <xsl:value-of select="substring($entry-time, 1, 10)" />
                <xsl:if test="string-length($entry-time) &gt;= 16">
                  <xsl:text> </xsl:text>
                  <xsl:value-of select="substring($entry-time, 12, 5)" />
                </xsl:if>
              </xsl:otherwise>
            </xsl:choose>
            <xsl:if test="substring($entry-time, string-length($entry-time)) = 'Z' or contains($entry-time, '+0000') or contains($entry-time, 'GMT')">
              <xsl:text> UTC</xsl:text>
            </xsl:if>
          </time>
        </xsl:if>

        <xsl:variable name="author-name">
          <xsl:choose>
            <xsl:when test="atom:author/atom:name">
              <xsl:value-of select="atom:author/atom:name" />
            </xsl:when>
            <xsl:when test="dc:creator">
              <xsl:value-of select="dc:creator" />
            </xsl:when>
            <xsl:when test="author">
              <xsl:value-of select="author" />
            </xsl:when>
          </xsl:choose>
        </xsl:variable>
        <xsl:if test="normalize-space($author-name) != ''">
          <span>•</span>
          <span><xsl:value-of select="$author-name" /></span>
        </xsl:if>

        <xsl:if test="atom:category | category">
          <span>•</span>
          <span class="feed-entry-tags">
            <xsl:for-each select="atom:category/@term | category">
              <span><xsl:value-of select="." /></span>
            </xsl:for-each>
          </span>
        </xsl:if>
      </div>
      <div class="feed-entry-content" data-feed-html="">
        <xsl:choose>
          <xsl:when test="atom:content">
            <xsl:value-of select="atom:content" disable-output-escaping="yes" />
          </xsl:when>
          <xsl:when test="content:encoded">
            <xsl:value-of select="content:encoded" disable-output-escaping="yes" />
          </xsl:when>
          <xsl:when test="atom:summary">
            <p data-feed-html=""><xsl:value-of select="atom:summary" disable-output-escaping="yes" /></p>
          </xsl:when>
          <xsl:otherwise>
            <xsl:value-of select="description" disable-output-escaping="yes" />
          </xsl:otherwise>
        </xsl:choose>
      </div>

      <div class="feed-entry-more">
        <a class="feed-read-more">
          <xsl:attribute name="href">
            <xsl:value-of select="atom:link[not(@rel) or @rel='alternate']/@href | link" />
          </xsl:attribute>
          在网站阅读全文并参与讨论 →
        </a>
      </div>
    </article>
  </xsl:template>

</xsl:stylesheet>
