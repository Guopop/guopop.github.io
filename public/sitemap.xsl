      </head>
      <body>
        <header class="site-header">
          <div class="site-header-inner">
            <a class="site-brand link-plain" href="/">Guopop</a>
            <a class="back-link link-plain" href="/">← 访问博客首页</a>
          </div>
        </header>

        <main class="container">
          <section class="info-card">
            <h1>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                <line x1="8" y1="2" x2="8" y2="18"></line>
                <line x1="16" y1="6" x2="16" y2="22"></line>
              </svg>
              <span>XML Sitemap（网站地图）</span>
            </h1>
            <p>
              这是为搜索引擎与索引爬虫生成的标准XML网站地图。当前共收录<strong><xsl:value-of select="count(sitemap:urlset/sitemap:url)"/></strong>个公开页面。
            </p>
            <div class="stats-bar" role="toolbar" aria-label="分类开关工具栏">
              <span class="filter-label">分类开关：</span>
              <button type="button" class="stat-pill" aria-pressed="true" data-filter="post" title="点击显示/隐藏文章">
                <span>📝 文章</span>
                <span class="stat-num"><xsl:value-of select="count(sitemap:urlset/sitemap:url[contains(sitemap:loc, '/posts/')])"/></span>
              </button>
              <button type="button" class="stat-pill" aria-pressed="true" data-filter="category" title="点击显示/隐藏分类">
                <span>📁 分类</span>
                <span class="stat-num"><xsl:value-of select="count(sitemap:urlset/sitemap:url[contains(sitemap:loc, '/categories/')])"/></span>
              </button>
              <button type="button" class="stat-pill" aria-pressed="true" data-filter="tag" title="点击显示/隐藏标签">
                <span>🏷️ 标签</span>
                <span class="stat-num"><xsl:value-of select="count(sitemap:urlset/sitemap:url[contains(sitemap:loc, '/tags/')])"/></span>
              </button>
              <button type="button" class="stat-pill" aria-pressed="true" data-filter="page" title="点击显示/隐藏页面">
                <span>📄 页面</span>
                <span class="stat-num"><xsl:value-of select="count(sitemap:urlset/sitemap:url[not(contains(sitemap:loc, '/posts/')) and not(contains(sitemap:loc, '/categories/')) and not(contains(sitemap:loc, '/tags/'))])"/></span>
              </button>
            </div>
          </section>

          <div class="filter-status" aria-live="polite">
            <span>当前显示：<strong id="visibleCount"><xsl:value-of select="count(sitemap:urlset/sitemap:url)"/></strong> / <xsl:value-of select="count(sitemap:urlset/sitemap:url)"/>个页面</span>
            <span class="filter-hint">提示：点击上方分类按钮可开启/关闭，点击表格内徽章可仅查看该类，点击表头可切换排序</span>
          </div>

          <div class="table-wrapper">
            <table id="sitemapTable">
              <thead>
                <tr>
                  <th id="thPath" data-col="path" aria-sort="none">
                    <button type="button" class="sort-btn" aria-label="按路径排序">
                      页面路径（Path） <span class="sort-icon" id="iconPath" aria-hidden="true">↕</span>
                    </button>
                  </th>
                  <th id="thTime" data-col="time" aria-sort="descending">
                    <button type="button" class="sort-btn" aria-label="按更新时间排序（当前降序）">
                      最后更新时间（Last Modified） <span class="sort-icon" id="iconTime" aria-hidden="true">↓</span>
                    </button>
                  </th>
                </tr>
              </thead>
              <tbody id="sitemapTbody">
                <xsl:for-each select="sitemap:urlset/sitemap:url">
                  <xsl:sort select="sitemap:lastmod" order="descending" />
                  <xsl:sort select="number(not(contains(sitemap:loc, '/posts/'))) * (1 + number(contains(sitemap:loc, '/categories/')) + 2 * number(not(contains(sitemap:loc, '/categories/')) and contains(sitemap:loc, '/tags/')))" data-type="number" />
                  <xsl:sort select="substring(sitemap:loc, 1, contains(sitemap:loc, '/posts/') * string-length(sitemap:loc))" order="descending" />
                  <xsl:sort select="sitemap:loc" />
                  <xsl:variable name="itemType">
                    <xsl:choose>
                      <xsl:when test="contains(sitemap:loc, '/posts/')">post</xsl:when>
                      <xsl:when test="contains(sitemap:loc, '/categories/')">category</xsl:when>
                      <xsl:when test="contains(sitemap:loc, '/tags/')">tag</xsl:when>
                      <xsl:otherwise>page</xsl:otherwise>
                    </xsl:choose>
                  </xsl:variable>

                  <xsl:variable name="itemPath">
                    <xsl:choose>
                      <xsl:when test="contains(substring-after(sitemap:loc, '://'), '/')">
                        <xsl:text>/</xsl:text>
                        <xsl:value-of select="substring-after(substring-after(sitemap:loc, '://'), '/')" />
                      </xsl:when>
                      <xsl:otherwise>/</xsl:otherwise>
                    </xsl:choose>
                  </xsl:variable>

                  <tr data-type="{$itemType}" data-path="{$itemPath}" data-time="{sitemap:lastmod}" data-order="{position()}">
                    <td>
                      <xsl:choose>
                        <xsl:when test="$itemType = 'post'">
                          <span class="type-badge" data-filter-type="post" title="点击仅查看文章（再次点击恢复全部）">文章</span>
                        </xsl:when>
                        <xsl:when test="$itemType = 'category'">
                          <span class="type-badge" data-filter-type="category" title="点击仅查看分类（再次点击恢复全部）">分类</span>
                        </xsl:when>
                        <xsl:when test="$itemType = 'tag'">
                          <span class="type-badge" data-filter-type="tag" title="点击仅查看标签（再次点击恢复全部）">标签</span>
                        </xsl:when>
                        <xsl:otherwise>
                          <span class="type-badge" data-filter-type="page" title="点击仅查看页面（再次点击恢复全部）">页面</span>
                        </xsl:otherwise>
                      </xsl:choose>

                      <a class="link-plain">
                        <xsl:attribute name="href">
                          <xsl:value-of select="sitemap:loc" />
                        </xsl:attribute>
                        <span class="path-text">
                          <xsl:value-of select="$itemPath" />
                        </span>
                      </a>
                    </td>
                    <td class="time-col">
                      <time datetime="{sitemap:lastmod}" data-utc="{sitemap:lastmod}">
                        <xsl:value-of select="substring(sitemap:lastmod, 1, 10)" />
                        <xsl:if test="string-length(sitemap:lastmod) &gt;= 16">
                          <xsl:text> </xsl:text>
                          <xsl:value-of select="substring(sitemap:lastmod, 12, 5)" />
                        </xsl:if>
                        <xsl:if test="substring(sitemap:lastmod, string-length(sitemap:lastmod)) = 'Z'">
                          <xsl:text> UTC</xsl:text>
                        </xsl:if>
                      </time>
                    </td>
                  </tr>
                </xsl:for-each>
                <tr id="emptyRow" class="is-hidden">
                  <td colspan="2" class="empty-state">
                    已隐藏所有分类的内容，请点击上方分类按钮开启显示。
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <footer class="page-footer">
            <p>© 2026 Guopop.</p>
          </footer>
        </main><script><![CDATA[(function(){function n(e){return(e<10?"0":"")+e}for(var e,t,o,i=document.querySelectorAll("time[data-utc]"),s=0;s<i.length;s++){if(t=i[s],o=Date.parse(t.getAttribute("data-utc")),isNaN(o))continue;e=new Date(o),t.title=t.textContent.trim(),t.textContent=e.getFullYear()+"-"+n(e.getMonth()+1)+"-"+n(e.getDate())+" "+n(e.getHours())+":"+n(e.getMinutes())}})(),function(){var t={sortByPath:"按路径排序",sortByPathAsc:"按路径排序（当前升序）",sortByPathDesc:"按路径排序（当前降序）",sortByTime:"按更新时间排序",sortByTimeAsc:"按更新时间排序（当前升序）",sortByTimeDesc:"按更新时间排序（当前降序）"},e={post:!0,category:!0,tag:!0,page:!0},r={col:"time",dir:"desc"},s=document.getElementById("sitemapTbody"),i=Array.from(s.querySelectorAll("tr[data-type]")),n=document.getElementById("emptyRow"),c=document.getElementById("visibleCount"),l=Array.from(document.querySelectorAll(".stat-pill")),a=document.getElementById("thPath"),o=document.getElementById("thTime"),d=[{col:"path",th:a,btn:a&&a.querySelector(".sort-btn"),icon:document.getElementById("iconPath"),label:t.sortByPath,asc:t.sortByPathAsc,desc:t.sortByPathDesc},{col:"time",th:o,btn:o&&o.querySelector(".sort-btn"),icon:document.getElementById("iconTime"),label:t.sortByTime,asc:t.sortByTimeAsc,desc:t.sortByTimeDesc}];function u(){var t=0;i.forEach(function(n){var s=!!e[n.getAttribute("data-type")];n.classList.toggle("is-hidden",!s),s&&t++}),l.forEach(function(t){var n=!!e[t.getAttribute("data-filter")];t.setAttribute("aria-pressed",n?"true":"false")}),n&&n.classList.toggle("is-hidden",t>0),c&&(c.textContent=t)}function h(t){e.hasOwnProperty(t)&&(e[t]=!e[t],u())}function m(t){var n=e[t]&&Object.keys(e).every(function(n){return n===t?e[n]:!e[n]});n?Object.keys(e).forEach(function(t){e[t]=!0}):Object.keys(e).forEach(function(n){e[n]=n===t}),u()}l.forEach(function(e){e.addEventListener("click",function(){var e=this.getAttribute("data-filter");h(e)})}),s.addEventListener("click",function(e){var t,n=e.target.closest(".type-badge");n&&(t=n.getAttribute("data-filte